# Runtime & Port
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/campusflow

# Authentication & Cryptography
JWT_SECRET=campusflow_dev_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=8h
QR_HMAC_SECRET=campusflow_dev_qr_hmac_secret_different_from_jwt_secret
APPROVAL_TOKEN_PEPPER=campusflow_dev_approval_token_pepper_secret

# Mail / SMTP Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CampusFlow <no-reply@college.edu>"

# Application URLs & Domains
APP_BASE_URL=http://localhost:5173
ALLOWED_EMAIL_DOMAINS=students.git.edu,git.edu
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
